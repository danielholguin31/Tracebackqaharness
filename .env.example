# Local defaults: Node API on 3001, Steel on 3000, Vite on 5173.
PORT=3001
HOST=127.0.0.1
STEEL_BASE_URL=http://localhost:3000
# STEEL_API_KEY=          # optional for authenticated Steel deployments
# OPENAI_API_KEY=         # required for autonomous tests, natural-language steps, and Operator
RUNNER_MODEL=gpt-4o-mini
RUNNER_MAX_STEPS=25
# Required for production owner access; leave unset only for local development.
# TRACEBACK_PASSWORD=
# SECRET_ENCRYPTION_KEY=  # long random value; keep stable across deployments
# COOKIE_SECURE=true     # enable behind HTTPS
# ALLOWED_ORIGINS=https://traceback.example.com
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=owner/repository
# LINEAR_API_KEY=
# LINEAR_TEAM_ID=
# Canonical intent and source discovery. Run one server per canonical folder.
# TRACEBACK_ROOT=/absolute/path/to/repository/.traceback
# TRACEBACK_REPO_ROOT=/absolute/path/to/repository
# CLI and MCP clients (supply API key using the host's secret configuration).
# TRACEBACK_API_URL=http://localhost:3001
# TRACEBACK_API_KEY=
